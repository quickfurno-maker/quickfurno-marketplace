# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public (safe to expose to the browser) — Google Places autocomplete on the
# enquiry/vendor forms. Restrict this key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-restricted-places-key

# SERVER ONLY — QF-MVP-75.03 route-time matching (Routes API, Compute Route
# Matrix). This MUST be a SEPARATE key from the browser key above: restrict it
# by IP (or leave it API-restricted to the Routes API only) and never expose it
# to the client. The provider is OFF unless ROUTE_TIME_PROVIDER_ENABLED is
# exactly "true"; with it unset, matching keeps its deterministic pre-75.03
# order and makes no external call.
ROUTE_TIME_PROVIDER_ENABLED=false
GOOGLE_ROUTES_API_KEY=your-server-only-routes-api-key
