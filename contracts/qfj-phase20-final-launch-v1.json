{
  "schema": "qfj.phase20.final-launch.v1",
  "version": 1,
  "certificationDate": "2026-10-06",
  "productionPolicy": {
    "runtime": "docker-vps",
    "awsRequiredAtLaunch": false,
    "kubernetesRequiredAtLaunch": false,
    "productionKubernetesAllowedByThisPhase": false,
    "productionDatabaseMutationAllowedByThisPhase": false,
    "agniAuthorityExpansionAllowedByThisPhase": false
  },
  "pollingGate": {
    "phase00KnownCoordinationBaselineQps": 18,
    "phase20MaximumKnownCoordinationQps": 9,
    "productionObservedQps": 8.28,
    "sampleDurationSeconds": 25.258,
    "minimumReductionPercent": 50,
    "observedReductionPercent": 54,
    "mechanism": "Redis/Valkey wake-up with jittered PostgreSQL recovery polling"
  },
  "distributedOwnershipGate": {
    "schedulerContenders": 20,
    "requiredOwners": 1,
    "requiredEffects": 1,
    "crashRecovery": true,
    "staleFenceRejection": true
  },
  "databaseBudgetGate": {
    "quickfurno": {
      "runtimeConnectionModel": "Supabase Data API",
      "phase18SyntheticPoolCeiling": 8
    },
    "jarvis": {
      "postgresMaxConnectionsBaseline": 60,
      "applicationConnectionBudget": 16,
      "gatewayReplicas": 2,
      "gatewayPoolMaxEach": 3,
      "workerReplicas": 2,
      "workerPoolMaxEach": 5
    }
  },
  "migrationGate": {
    "pattern": ["expand", "backfill", "compatibility", "contract"],
    "rehearsalDatabase": "disposable-postgresql",
    "productionMutation": false,
    "rollbackBeforeContractRequired": true
  },
  "securityAdvisorGate": {
    "allErrorAndWarnFindingsRequireDisposition": true,
    "acceptedByDesign": [
      "quickfurno.security_definer_view.vendor_public_v",
      "quickfurno.authenticated_security_definer_function_executable.is_admin",
      "quickfurno.authenticated_security_definer_function_executable.owns_vendor"
    ],
    "externalLaunchPrerequisites": ["quickfurno.auth_leaked_password_protection"],
    "informationalFindingsDoNotBlockWithoutMeasuredEvidence": true
  },
  "portabilityGate": {
    "phase21ExitInventoryDesignRequired": true,
    "identityProviderDecisionRequired": true,
    "stableInternalPrincipalRequired": true,
    "providerAuthAdapterRequired": true,
    "futureInfrastructureMustReplaceImplementationsNotCoreAuthority": true
  },
  "runtimeHardeningGate": {
    "nonRoot": true,
    "readOnlyRootFilesystem": true,
    "noPrivilegeEscalation": true,
    "dropAllCapabilities": true,
    "noBusinessHostDisk": true,
    "boundedResources": true
  },
  "finalEvidenceGate": {
    "postMergeFullCiRequired": true,
    "postMergeSupplyChainRequired": true,
    "signedImmutableDigestsRequired": true,
    "phase19KubernetesEvidenceRequired": true,
    "phase17RestoreEvidenceRequired": true,
    "phase18LoadSoakChaosEvidenceRequired": true
  }
}
