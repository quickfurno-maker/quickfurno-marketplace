# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — never expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public (safe to expose to the browser) — Google Places autocomplete on the
# enquiry/vendor forms. Restrict this key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-browser-restricted-places-key

# SERVER ONLY — QF-MVP-75.03 route-time matching (Routes API, Compute Route
# Matrix). This MUST be a SEPARATE key from the browser key above: restrict it
# by IP (or leave it API-restricted to the Routes API only) and never expose it
# to the client. The provider is OFF unless ROUTE_TIME_PROVIDER_ENABLED is
# exactly "true"; with it unset, matching keeps its deterministic pre-75.03
# order and makes no external call.
ROUTE_TIME_PROVIDER_ENABLED=false
GOOGLE_ROUTES_API_KEY=your-server-only-routes-api-key
# SERVER ONLY — QF-MVP-60 optional Jarvis integration. Everything defaults OFF.
# Jarvis must remain a separate service/repository; QuickFurno holds no model-provider key.
QF_JARVIS_MODE=off
QF_JARVIS_CORE_DECISION_ENABLED=false
QF_JARVIS_RIYA_ENABLED=false
QF_JARVIS_ANISHA_ENABLED=false
QF_JARVIS_RIYA_WEB_TURN_ENABLED=false
QF_JARVIS_CONTEXT_READ_ENABLED=false
QF_JARVIS_SERVICE_AVAILABILITY_ENABLED=false
QF_JARVIS_TENANT_ID=
QF_JARVIS_RECOMMENDATION_INTAKE_ENABLED=false
QF_JARVIS_ACTION_PROPOSALS_ENABLED=false
QF_JARVIS_ENABLED_ACTION_TYPES=

# JSON array of QuickFurno-held PUBLIC Ed25519 verification keys for Jarvis -> Core.
# Example shape only; never put a Jarvis private signing key here.
QF_JARVIS_CORE_VERIFICATION_KEYS_JSON=

# Dedicated PUBLIC verification keys for Jarvis OS read-only operator snapshots.
# Keep separate from action-signing trust so web/mobile observation never inherits action authority.
QF_JARVIS_OS_READ_VERIFICATION_KEYS_JSON=

# Separate Jarvis OS command trust lane. Default OFF even when read-only snapshots are enabled.
# The authenticated Jarvis OS operator id is transported in a signed header; the client cannot spoof it.
QF_JARVIS_OS_COMMANDS_ENABLED=false
QF_JARVIS_OS_COMMAND_VERIFICATION_KEYS_JSON=

# QuickFurno -> private Jarvis/Riya server transport. Leave blank while disabled.
# The signing key is server-only and must be managed outside Git.
QF_JARVIS_BASE_URL=
QF_JARVIS_SIGNING_KEY_ID=
QF_JARVIS_SIGNING_PRIVATE_KEY_PEM=
# Prefer this root-owned file source in production; never configure both PEM and FILE.
QF_JARVIS_SIGNING_PRIVATE_KEY_FILE=

# Conversational WhatsApp lane. Keep disabled until inbound-only production verification is complete.
QF_JARVIS_WHATSAPP_ENABLED=false
# Separate default-OFF gate for exact turn-bound media delivery to Jarvis. Never exposes Meta credentials.
QF_JARVIS_WHATSAPP_MEDIA_ENABLED=false
WHATSAPP_CONVERSATIONAL_ACCESS_TOKEN=
WHATSAPP_CONVERSATIONAL_PHONE_NUMBER_ID=
WHATSAPP_CONVERSATIONAL_WABA_ID=
WHATSAPP_CONVERSATIONAL_GRAPH_API_VERSION=

# AES-256-GCM keyring for request-memory WhatsApp destinations and Jarvis reply bodies.
# QF_CONVERSATION_SEAL_KEYS is a JSON object of key-id -> 32-byte base64url key. Never commit real keys.
QF_CONVERSATION_SEAL_PRIMARY_KEY_ID=
QF_CONVERSATION_SEAL_KEYS=
