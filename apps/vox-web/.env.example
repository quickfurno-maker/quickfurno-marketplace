# VOX staff app is fail-closed until owner-approved staging launch.
VOX_DEMO_PREVIEW=disabled
VOX_STAFF_PORTAL_ENABLED=disabled
# owner | scoped, disabled unless separately approved in private staging
VOX_STAFF_VIEW_MODE=disabled
# Fixed backend-only project keys; NOT service_role.
VOX_SUPABASE_URL=
VOX_SUPABASE_PUBLISHABLE_KEY=
# Back-end destination allowlisted to staging-core.quickfurno.in ONLY at this phase
VOX_CORE_ORIGIN=
VOX_EXPECTED_ORIGIN=https://vox.quickfurno.in
# Never put financial, Meta or Supabase service_role keys in this web app.

# Owner-only AOS health workspace; keep disabled until signed private Staging
VOX_INTELLIGENCE_VIEW_ENABLED=disabled

# Restricted Team Leader read/review path; disabled without private staging
VOX_STAFF_REVIEW_WEB_ENABLED=disabled
# Team Leader queue and Core-reviewed decision; disabled until signed staging
VOX_STAFF_REVIEW_WEB_ENABLED=disabled

# Experimental staff internal tasks and native Studio; both OFF by default
VOX_VENDOR_TASK_UI_ENABLED=disabled

# Internal-only Service Desk tasks; separate Core gate; no provider or vendor replies
VOX_SUPPORT_TASK_UI_ENABLED=disabled
VOX_STUDIO_WEB_ENABLED=disabled

# Owner review of operational intents; disabled before private staging
VOX_OPERATIONAL_REVIEW_UI_ENABLED=disabled

# Internal follow-up execution UI stays disabled without private Staging gates
VOX_APPROVED_FOLLOWUP_WEB_ENABLED=disabled

# Disabled pending two-person Core approval and private staging authentication
VOX_OPERATIONAL_PROPOSAL_UI_ENABLED=disabled

# Optional per-session Core-authorized owner/scoped routing; keep disabled until live MFA tests
# VOX_STAFF_VIEW_MODE=dual
# VOX-12B staff proposal; separate from owner approval/execution. OFF until private Staging
VOX_FOLLOWUP_PROPOSALS_WEB_ENABLED=disabled
