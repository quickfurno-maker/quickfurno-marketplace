# Prefer TF_VAR_cloudflare_api_token for the secret.
cloudflare_zone_id = "replace-with-zone-id"
cloudflare_plan    = "free"

# Free zones automatically receive the Cloudflare Free Managed Ruleset.
# Reconcile/import any existing entry-point rulesets before enabling writes.
enable_managed_waf = false
enable_edge_rules  = false
enable_cache_rules = false
